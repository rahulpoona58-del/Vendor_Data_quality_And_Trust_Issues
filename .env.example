# =========================================================================
# VENDOR DATA QUALITY & TRUST PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development configuration.
# DO NOT COMMIT '.env' CONTAINING REAL PRODUCTION SECRETS TO GIT REPOSITORY.
# =========================================================================

# Environment Mode: 'development', 'testing', or 'production'
FLASK_ENV=development

# Application Security Keys
# Generate strong random strings using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database Connection URLs
# SQLite (Local Dev Fallback): sqlite:////app/instance/vendor_trust.db
# PostgreSQL (Production Stack): postgresql://vendor_user:vendor_password@localhost:5432/vendor_trust
DATABASE_URL=sqlite:///instance/vendor_trust.db
TEST_DATABASE_URL=sqlite:///:memory:

# Redis Cache & Messaging Queue URL
REDIS_URL=redis://localhost:6379/0

# Storage & Folder Locations
UPLOAD_FOLDER=uploads
CSV_DATA_PATH=vendors_20_columns.csv
MAX_CONTENT_LENGTH=16777216

# Logging & Diagnostic Telemetry
# Options: 'DEBUG', 'INFO', 'WARNING', 'ERROR'
LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs/app.log

# AI/ML Engine Parameters
AI_MODEL_PATH=src/infrastructure/ml/models
AI_CONFIDENCE_THRESHOLD=0.75

# API Rate Limiting Thresholds (Requests / Window in Seconds)
RATE_LIMIT_LOGIN_COUNT=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_SEARCH_COUNT=30
RATE_LIMIT_SEARCH_WINDOW=60
RATE_LIMIT_AI_COUNT=15
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_UPLOAD_COUNT=10
RATE_LIMIT_UPLOAD_WINDOW=60
